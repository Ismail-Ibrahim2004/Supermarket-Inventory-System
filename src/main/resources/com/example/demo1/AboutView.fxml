<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" stylesheets="@css/Dashboard_style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <content>
        <VBox spacing="25" styleClass="content-pane">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>

            <VBox alignment="CENTER" spacing="15" styleClass="chart-container">
                <padding><Insets bottom="40" top="40" /></padding>
                <Label prefHeight="60.0" prefWidth="72.0" style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #1A71E4, #1659B4); -fx-padding: 20; -fx-background-radius: 15; -fx-font-size: 32;" textFill="white">
               <graphic>
                  <ImageView fitHeight="54.0" fitWidth="53.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@images/online-shopping.png" />
                     </image>
                  </ImageView>
               </graphic></Label>
                <Label styleClass="header-title" text="Supermarket Manager" />
                <Label styleClass="header-subtitle" text="Version 1.0.0" />
                <Label alignment="CENTER" maxWidth="600" styleClass="card-label" text="A comprehensive desktop application designed to streamline supermarket operations, manage inventory, track sales, and improve overall business efficiency." textAlignment="CENTER" wrapText="true" />
            </VBox>

            <VBox spacing="20" styleClass="chart-container">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label prefHeight="34.0" prefWidth="33.0" style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #00C155, #00A562); -fx-background-radius: 10;" styleClass="icon-label-green">
                  <graphic>
                     <ImageView fitHeight="30.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@images/check.png" />
                        </image>
                     </ImageView>
                  </graphic></Label>
                    <VBox>
                        <Label styleClass="p-name" text="Key Features" />
                        <Label styleClass="p-category" text="What makes this application powerful" />
                    </VBox>
                </HBox>

                <GridPane hgap="30" vgap="25">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>

                    <HBox spacing="15" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label style="-fx-background-color: #EFF6FF;" styleClass="icon-label-blue">
                     <graphic>
                        <ImageView fitHeight="30.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/data-server.png" />
                           </image>
                        </ImageView>
                     </graphic></Label>
                        <VBox spacing="5">
                            <Label styleClass="p-name" text="Inventory Management" />
                            <Label styleClass="p-category" text="Track products, quantities, and suppliers in real-time" wrapText="true" />
                        </VBox>
                    </HBox>

                    <HBox spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label styleClass="icon-label-purple">
                     <graphic>
                        <ImageView fitHeight="30.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/online-shopping%20(1).png" />
                           </image>
                        </ImageView>
                     </graphic></Label>
                        <VBox spacing="5">
                            <Label styleClass="p-name" text="Point of Sale" />
                            <Label styleClass="p-category" text="Fast and efficient checkout process for customers" wrapText="true" />
                        </VBox>
                    </HBox>

                    <HBox spacing="15" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label style="-fx-background-color: #F0FDF4; -fx-background-radius: 10;" styleClass="icon-label-green">
                     <graphic>
                        <ImageView fitHeight="30.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/flash.png" />
                           </image>
                        </ImageView>
                     </graphic></Label>
                        <VBox spacing="5">
                            <Label styleClass="p-name" text="Sales Analytics" />
                            <Label styleClass="p-category" text="Comprehensive reports and insights on sales performance" wrapText="true" />
                        </VBox>
                    </HBox>

                    <HBox spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label style="-fx-background-color: #FFF7ED; -fx-background-radius: 10;" styleClass="icon-label-orange">
                     <graphic>
                        <ImageView fitHeight="30.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/security.png" />
                           </image>
                        </ImageView>
                     </graphic></Label>
                        <VBox spacing="5">
                            <Label styleClass="p-name" text="User Management" />
                            <Label styleClass="p-category" text="Role-based access control for admins and cashiers" wrapText="true" />
                        </VBox>
                    </HBox>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>
            </VBox>

            <VBox spacing="20" styleClass="chart-container">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #1A71E4, #1659B4);" styleClass="icon-label-blue">
                  <graphic>
                     <ImageView fitHeight="30.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@images/code.png" />
                        </image>
                     </ImageView>
                  </graphic></Label>
                    <VBox>
                        <Label styleClass="p-name" text="Technical Details" />
                        <Label styleClass="p-category" text="Built with modern technologies" />
                    </VBox>
                </HBox>
                <HBox alignment="CENTER" spacing="20">
                    <VBox alignment="CENTER" prefWidth="180" spacing="5" styleClass="filter-button">
                        <Label styleClass="p-name" text="JavaFX" />
                        <Label styleClass="p-category" text="UI Framework" />
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="180" spacing="5" styleClass="filter-button">
                        <Label styleClass="p-name" text="MySQL" />
                        <Label styleClass="p-category" text="Database" />
                    </VBox>
                    <VBox alignment="CENTER" prefWidth="180" spacing="5" styleClass="filter-button">
                        <Label styleClass="p-name" text="JDBC" />
                        <Label styleClass="p-category" text="Data Connectivity" />
                    </VBox>
                </HBox>
            </VBox>

            <VBox alignment="CENTER" spacing="5">
                <padding><Insets bottom="20" top="20" /></padding>
                <Label styleClass="p-category" text="Made with  for supermarket management" />
                <Label styleClass="p-category" text="© 2025 Supermarket Manager. All rights reserved." />
            </VBox>
        </VBox>
    </content>
</ScrollPane>
