<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@css/product_style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo1.ProductsController">
    <top>
        <VBox spacing="15" stylesheets="@css/product_style.css">
            <padding><Insets bottom="20" left="25" right="25" top="20" /></padding>
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Label style="-fx-font-size: 24; -fx-font-weight: bold;" text="Products Inventory" />
                    <Label style="-fx-text-fill: gray;" text="Manage your stock and prices" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#openAddProductPopup" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 8;" text="+ Add Product">
                    <padding><Insets bottom="10" left="20" right="20" top="10" /></padding>
                </Button>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tableView" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="idCol" prefWidth="60" text="ID" />
                <TableColumn fx:id="nameCol" prefWidth="150" text="Name" />
                <TableColumn fx:id="categoryCol" prefWidth="120" text="Category" />
                <TableColumn fx:id="quantityCol" prefWidth="80" text="Qty" />
                <TableColumn fx:id="priceCol" prefWidth="100" text="Price" />
                <TableColumn fx:id="supplierCol" prefWidth="100" text="Supplier" />
                <TableColumn fx:id="statusCol" prefWidth="120" text="Status" />
                <TableColumn fx:id="actionsCol" prefWidth="100" text="Actions" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
        </TableView>
    </center>
</BorderPane>
