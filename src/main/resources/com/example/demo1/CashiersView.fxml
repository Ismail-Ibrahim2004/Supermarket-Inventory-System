<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600.0" prefWidth="950.0" spacing="20.0" styleClass="main-container" stylesheets="@css/Cashiers_style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo1.CashierController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <VBox HBox.hgrow="ALWAYS">
            <Label styleClass="page-title" text="Cashiers Management" />
            <Label styleClass="page-subtitle" text="Monitor staff performance and account status" />
        </VBox>
        <Button onAction="#handleAddCashier" styleClass="add-btn" text="+ Add New Cashier" />
    </HBox>

    <TableView fx:id="cashierTable" styleClass="modern-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName" prefWidth="150.0" text="Full Name" />
            <TableColumn fx:id="colUsername" prefWidth="120.0" text="Username" />
            <TableColumn fx:id="colRole" prefWidth="100.0" text="Role" />
            <TableColumn fx:id="colLastLogin" prefWidth="150.0" text="Last Login" />
            <TableColumn fx:id="colSalary" text="Salary" prefWidth="100" />
            <TableColumn fx:id="colShift" text="Shift" prefWidth="100" />
            <TableColumn fx:id="colSales" prefWidth="130.0" text="Sales Count" />
            <TableColumn fx:id="colPerformance" prefWidth="120.0" text="Performance" />
            <TableColumn fx:id="colActions" prefWidth="100.0" text="Actions" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>