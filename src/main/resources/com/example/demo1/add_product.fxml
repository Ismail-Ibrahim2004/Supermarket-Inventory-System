<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo1.AddProductController">
    <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>

    <VBox spacing="5">
        <Label fx:id="titleLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Product Details" />
        <Label style="-fx-text-fill: #64748b;" text="Please enter product information below" />
    </VBox>

    <GridPane hgap="15" vgap="15">
        <columnConstraints>
            <ColumnConstraints minWidth="100" prefWidth="120" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
        </columnConstraints>

        <Label text="Product Name:" GridPane.rowIndex="0" />
        <TextField fx:id="nameField" promptText="e.g. Milk 1L" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Category:" GridPane.rowIndex="1" />
        <TextField fx:id="categoryField" promptText="e.g. Dairy" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Quantity:" GridPane.rowIndex="2" />
        <TextField fx:id="quantityField" promptText="0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Buying Price:" GridPane.rowIndex="3" />
        <TextField fx:id="buyingPriceField" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Selling Price:" GridPane.rowIndex="4" />
        <TextField fx:id="sellingPriceField" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label text="Supplier:" GridPane.rowIndex="5" />
        <ComboBox fx:id="supplierComboBox" maxWidth="Infinity" promptText="Select Supplier" GridPane.columnIndex="1" GridPane.rowIndex="5" />
    </GridPane>

    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button onAction="#closeWindow" style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-cursor: hand;" text="Cancel" />
        <Button onAction="#handleSave" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 25; -fx-cursor: hand;" text="Save Product" />
    </HBox>
</VBox>