<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<HBox fx:id="mainRoot" prefHeight="600.0" prefWidth="900.0" stylesheets="@css/Login_style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo1.LoginController">

    <VBox alignment="CENTER" spacing="20" styleClass="left-pane" HBox.hgrow="ALWAYS">
        <StackPane styleClass="logo-container">
         <ImageView fitHeight="65.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@images/online-shopping.png" />
            </image>
         </ImageView>
        </StackPane>
        <Label styleClass="main-title" text="Supermarket Manager">
         <font>
            <Font size="5.0" />
         </font></Label>
        <Label styleClass="main-subtitle" text="Manage your supermarket operations efficiently" />
    </VBox>

    <VBox alignment="CENTER" spacing="15" styleClass="right-pane" HBox.hgrow="ALWAYS">
        <padding>
            <Insets bottom="40.0" left="60.0" right="60.0" top="40.0" />
        </padding>

        <VBox alignment="CENTER" spacing="5">
            <StackPane minHeight="49.0" prefWidth="55.0" styleClass="small-logo-container">
                <ImageView fitHeight="33.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@images/online-shopping.png" />
                    </image>
                </ImageView>
            </StackPane>
            <Label styleClass="welcome-text" text="Welcome Back" />
            <Label styleClass="signin-text" text="Sign in to your account" />
        </VBox>

        <VBox maxWidth="350" spacing="5">
            <Label styleClass="field-label" text="Username" />
            <TextField fx:id="usernameField" promptText="Enter your username" styleClass="input-field" />
        </VBox>

        <VBox maxWidth="350" spacing="5">
            <Label styleClass="field-label" text="Password" />
            <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="input-field" />
        </VBox>

        <VBox maxWidth="350" spacing="5">
            <Label styleClass="field-label" text="Role" />
            <ComboBox fx:id="roleComboBox" prefHeight="40.0" prefWidth="350.0" styleClass="combo-box-style" />
        </VBox>

        <HBox alignment="CENTER_LEFT" maxWidth="350">
            <CheckBox fx:id="rememberMeCheckBox" styleClass="custom-checkbox" text="Remember me" />
            <Region HBox.hgrow="ALWAYS" />
            <Hyperlink fx:id="forgotPasswordLink" styleClass="forgot-link" text="Forgot password?" />        </HBox>

        <Button fx:id="signInButton" maxWidth="350" prefHeight="45.0" styleClass="primary-button" text="Sign In" />

        <Button fx:id="demoAdminButton" maxWidth="350" prefHeight="40.0" styleClass="secondary-button" text="Demo Admin Login" />
        <Button fx:id="demoCashierButton" maxWidth="350" prefHeight="40.0" styleClass="secondary-button" text="Demo Cashier Login" />

        <HBox alignment="CENTER" spacing="10">
            <Circle fx:id="statusIndicator" fill="#cccccc" radius="5.0" />
            <Label fx:id="statusLabel" styleClass="footer-text" text="Checking connection..." />
        </HBox>

        <Label styleClass="footer-text" text="Version 1.0.0 • © 2025 Supermarket Manager" />
    </VBox>
</HBox>
